# Copy to .env for local dev. On Render these live in the service environment.
# Never commit real values.

# ---- Required ----
# App Dashboard > App Settings > Basic
META_APP_ID=
META_APP_SECRET=

# The token Meta echoes back during the webhook handshake. Any random string,
# but it must match exactly what you type in the App Dashboard.
VERIFY_TOKEN=

# Protects the dashboard (HTTP Basic - leave the username blank, type the password).
DASHBOARD_PASSWORD=

# ---- Optional ----
GRAPH_VERSION=v23.0
PUBLIC_URL=                 # auto-detected on Render via RENDER_EXTERNAL_URL
ENFORCE_SIGNATURE=true      # set false only to poke the endpoint with curl
REQUIRE_AUTH=true
KEEP_ALIVE=true             # self-ping so the free instance does not sleep
MAX_EVENTS=500

# ---- WhatsApp ----
WA_EMBEDDED_CONFIG_ID=      # Facebook Login for Business > Configurations
WA_ACCESS_TOKEN=            # quick-test token (System User or temporary)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_REGISTER_PIN=000000

# ---- Facebook Page / Messenger ----
PAGE_ACCESS_TOKEN=
PAGE_ID=

# ---- Instagram ----
IG_ACCESS_TOKEN=
IG_USER_ID=

# ---- Ads ----
ADS_ACCESS_TOKEN=
ADS_AD_ACCOUNT_ID=          # numeric, without the act_ prefix

# Comma separated. Trim this down to what your app is actually approved for.
OAUTH_SCOPES=
